# Credenciais de assinatura do APK de release.
#
# Copie este arquivo para credentials/keystore.properties e preencha.
# O plugin withSamsung.js o copia para android/keystore.properties no prebuild,
# e o build.gradle gerado le os valores de la. NUNCA versionar o preenchido.
#
# RELEASE_STORE_FILE e relativo ao diretorio android/app/.
RELEASE_STORE_FILE=careplus-release.keystore
RELEASE_STORE_PASSWORD=
RELEASE_KEY_ALIAS=careplus
RELEASE_KEY_PASSWORD=
