# ============================================================================
# CarePlus Predict V2 — Template de variaveis de ambiente
# ============================================================================
# 1. Copie: cp .env.example .env
# 2. Preencha com valores reais no .env (NUNCA commite o .env)
# Placeholders abaixo sao obviamente falsos e seguros.
# ============================================================================

# ---- Ambiente ----
NODE_ENV=development
LOG_LEVEL=info

# ---- Backend / API ----
API_PORT=3000
# URL publica da API (o mobile/web leem daqui — NUNCA hardcode no codigo)
API_BASE_URL=http://localhost:3000

# ---- Supabase ----
# Painel: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=COLE_A_ANON_KEY_AQUI_NAO_COMMITE
SUPABASE_SERVICE_ROLE_KEY=COLE_A_SERVICE_ROLE_KEY_AQUI_NAO_COMMITE
# Connection string do Postgres (para migrations/Prisma se usado)
DATABASE_URL=postgresql://postgres:SENHA@db.SEU_PROJETO.supabase.co:5432/postgres

# ---- Auth (JWT) ----
JWT_ACCESS_SECRET=GERE_UM_SEGREDO_FORTE_NAO_COMMITE
JWT_REFRESH_SECRET=GERE_OUTRO_SEGREDO_FORTE_NAO_COMMITE
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---- IA BluaDiagnostics (servico externo via HTTP) ----
# URL do wrapper FastAPI da Blua. NUNCA hardcode no codigo — sempre daqui.
BLUA_API_URL=http://localhost:8001
BLUA_API_TIMEOUT_MS=30000

# ---- OpenAI (RAG da base de conhecimento do medico) ----
# Atras de interface trocavel (EmbeddingProvider/LLMProvider)
OPENAI_API_KEY=COLE_SUA_CHAVE_OPENAI_AQUI_NAO_COMMITE
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_GENERATION_MODEL=gpt-4o-mini

# ---- Redis (fila de agregacoes/jobs) ----
REDIS_URL=redis://localhost:6379

# ---- Observabilidade (OpenTelemetry) ----
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
